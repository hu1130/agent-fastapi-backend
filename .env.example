# Server
APP_HOST=127.0.0.1
APP_PORT=8888
ALLOWED_ORIGINS=http://127.0.0.1:8888,http://localhost:8888,null

# Agent 1: DeepSeek-compatible chat completions
TEXT_API_URL=https://api.deepseek.com/v1/chat/completions
TEXT_API_KEY=sk-your-deepseek-key
TEXT_MODEL=deepseek-chat

# Agent 2/3: Alibaba DashScope / Bailian
DASHSCOPE_API_KEY=sk-your-dashscope-key
IMAGE_PROVIDER=qwen
IMAGE_MODEL=qwen-image-2.0
IMAGE_SIZE=1024*1024
VIDEO_PROVIDER=qwen
VIDEO_MODEL=happyhorse-1.0-i2v
VIDEO_DURATION=5

# Optional: Jimeng via Wanjie Fangzhou
JIMENG_API_KEY=
JIMENG_IMAGE_MODEL=jimeng_t2i_v40
JIMENG_IMAGE_SIZE=1024
JIMENG_VIDEO_MODEL=jimeng_t2v_v30
